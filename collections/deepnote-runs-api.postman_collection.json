  "info": {
    "_postman_id": "0b586c20-0133-4053-abb3-20c4a076bef3",
    "name": "Deepnote Public Execute (v1) Execute (v1) Runs API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Deepnote Public API v2 (preview) for running notebooks programmatically and managing projects, notebooks, and execution runs. Notebooks can be executed via POST /runs and their status polled via GET /runs/{runId}. Endpoints and schemas may change while the API is in preview. A legacy v1 execute endpoint is also documented for triggering a notebook's machine.\n\nContact Support:\n Name: Deepnote Support",
      "type": "text/plain"
    }
  }
