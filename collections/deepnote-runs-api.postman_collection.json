            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notebookId\": \"<string>\",\n  \"detached\": \"<boolean>\",\n  \"detachedRunStorageMode\": \"<string>\",\n  \"blockIds\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"runDependentBlocks\": \"<boolean>\",\n  \"inputs\": {\n    \"key_0\": true\n  }\n}",
