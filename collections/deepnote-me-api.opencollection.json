{
  "opencollection": "1.0.0",
  "info": {
    "name": "Deepnote Public Execute (v1) Execute (v1) Me API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Me",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get caller identity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.deepnote.com/v2/me"
          },
          "docs": "Returns the calling API key, the user that created it, the workspace it belongs to, and the caller's access level in that workspace."
        }
      ]
    }
  ],
  "bundled": true
}